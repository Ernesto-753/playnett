# Copia este archivo como .env y llena los valores.

# MongoDB local:
MONGODB_URI=mongodb://127.0.0.1:27017/playnett
# MongoDB Atlas (gratis): pega aquí la cadena de conexión de tu cluster
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/playnett

# Secreto para firmar las sesiones (pon una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo

PORT=3000
